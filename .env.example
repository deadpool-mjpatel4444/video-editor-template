# Remotion Lambda rendering environment
# Keeps sensitive values out of source control and makes local dev predictable.

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=[REDACTED_KEY]
AWS_SECRET_ACCESS_KEY=[REDACTED_KEY]

REMOTION_BUCKET=your-bucket-name
REMOTION_COMPOSITION=MyVideo
REMOTION_VERSION=1.0.0

# Optional: Lambda-specific settings (useful for ARM64)
# AWS_LAMBDA_FUNCTION_NAME=name-of-your-lambda
# TEMPORARY_S3_PREFIX=videos/
